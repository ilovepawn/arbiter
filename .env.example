# MySQL
MYSQL_ROOT_PASSWORD=rootpw
MYSQL_DATABASE=arbiter
MYSQL_USER=arbiter
MYSQL_PASSWORD=arbiterpw

# RabbitMQ
RABBITMQ_DEFAULT_USER=arbiter
RABBITMQ_DEFAULT_PASS=arbiterpw

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Spring (used by app service)
SPRING_PROFILES_ACTIVE=dev

# Auth — Keycloak (dev/prod 전용. local 은 application-local.yml 에 하드코딩됨)
KEYCLOAK_ISSUER_URI=
ALLOWED_ORIGINS=
